DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
DB_CA_CERT=

# You can use MYSQL_URL instead of the DB_* values above when your provider gives one.
MYSQL_URL=

JWT_SECRET=change-me
SESSION_EXPIRES_IN=2h
# Use the same OAuth client ID for GOOGLE_CLIENT_ID and VITE_GOOGLE_CLIENT_ID.
# Add https://your-backend.onrender.com/api/auth/google/redirect as an authorized redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=
# Comma-separated iOS and Android OAuth client IDs accepted by the mobile app.
GOOGLE_MOBILE_CLIENT_IDS=

EMAIL_USER=
EMAIL_PASS=
EMAIL_SEND_TIMEOUT_MS=30000
EMAIL_CONNECTION_TIMEOUT_MS=30000
EMAIL_GREETING_TIMEOUT_MS=30000
EMAIL_SOCKET_TIMEOUT_MS=30000
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Finovo AI

# Server-only secrets. Never prefix these with VITE_ or reference them in frontend code.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Legacy single-key alias (optional).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
GEMINI_ADMIN_EMAILS=hetarth150804@gmail.com
GEMINI_MONTHLY_CREDIT_LIMIT=10000
GEMINI_WARNING_PERCENT=80
# fallback skips Gemini after the limit; block rejects AI requests after the limit.
GEMINI_LIMIT_BEHAVIOR=fallback
# One credit equals this many USD of estimated provider cost.
AI_CREDIT_USD=0.001
GEMINI_RATE_LIMIT_USER_PER_MINUTE=20
GEMINI_RATE_LIMIT_IP_PER_MINUTE=40

# Text AI priority. The app tries providers left-to-right, then each provider's fallback models.
# Unified AI order: Gemini first, then Groq, OpenRouter, and Hugging Face.
AI_TEXT_PROVIDER_PRIORITY=gemini,groq,openrouter,huggingface
AI_PROVIDER=gemini

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_FALLBACK_MODELS=qwen/qwen3-235b-a22b:free,meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Finovo
OPENROUTER_VISION_MODEL=openrouter/free

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_FALLBACK_MODELS=mistralai/Mistral-7B-Instruct-v0.3,Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# Secret used by the scheduled report workflow when it calls /api/admin/monthly-reports/send.
MONTHLY_REPORT_CRON_SECRET=

# Frontend only. Set this in Vercel to your deployed backend origin, without /api.
VITE_API_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=
VITE_GA_MEASUREMENT_ID=
VITE_HMR_PORT=24679
