DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
DB_CA_CERT=

# You can use MYSQL_URL instead of the DB_* values above when your provider gives one.
MYSQL_URL=

JWT_SECRET=change-me
SESSION_EXPIRES_IN=2h

EMAIL_USER=
EMAIL_PASS=
EMAIL_SEND_TIMEOUT_MS=30000
EMAIL_CONNECTION_TIMEOUT_MS=30000
EMAIL_GREETING_TIMEOUT_MS=30000
EMAIL_SOCKET_TIMEOUT_MS=30000
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=FinSight AI

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_PROVIDER=gemini

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# Frontend only. Set this in Vercel to your deployed backend origin, without /api.
VITE_API_URL=http://localhost:3000
