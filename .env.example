DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
DB_CA_CERT=

# You can use MYSQL_URL instead of the DB_* values above when your provider gives one.
MYSQL_URL=

JWT_SECRET=change-me
SESSION_EXPIRES_IN=2h
# Use the same OAuth client ID for GOOGLE_CLIENT_ID and VITE_GOOGLE_CLIENT_ID.
# Add https://your-backend.onrender.com/api/auth/google/redirect as an authorized redirect URI in Google Cloud.
GOOGLE_CLIENT_ID=

EMAIL_USER=
EMAIL_PASS=
EMAIL_SEND_TIMEOUT_MS=30000
EMAIL_CONNECTION_TIMEOUT_MS=30000
EMAIL_GREETING_TIMEOUT_MS=30000
EMAIL_SOCKET_TIMEOUT_MS=30000
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Finovo AI

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Text AI priority. The app tries providers left-to-right, then each provider's fallback models.
# Recommended free-tier order for text: Groq first, Gemini second, OpenRouter third, Hugging Face fourth.
AI_TEXT_PROVIDER_PRIORITY=groq,gemini,openrouter,huggingface
AI_PROVIDER=gemini

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,qwen/qwen3-32b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENROUTER_FALLBACK_MODELS=qwen/qwen3-235b-a22b:free,meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Finovo

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_FALLBACK_MODELS=mistralai/Mistral-7B-Instruct-v0.3,Qwen/Qwen2.5-7B-Instruct

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# Frontend only. Set this in Vercel to your deployed backend origin, without /api.
VITE_API_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=
VITE_HMR_PORT=24679
