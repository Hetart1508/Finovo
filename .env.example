# AI provider
# Gemini is primary. Ollama remains available as a local fallback.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Ollama AI Setup (Fallback, Local - No Free Limits)
# Install: brew install ollama && ollama serve (background)
# Pull models: ollama pull llava:13b  (vision for bills)
#              ollama pull llama3.2:3b (insights, fast)

OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava:13b
OLLAMA_TEXT_MODEL=llama3.2:3b

JWT_SECRET=your-super-secret-jwt-key-change-in-prod
EMAIL_USER=your@gmail.com
EMAIL_PASS=your-app-password

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=expense_tracker

# Backend runtime
# Use comma-separated origins when frontend and backend run separately.
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
