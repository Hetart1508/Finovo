    {
      "name": "Statement Import",
      "item": [
        {
          "name": "Preview Statement JSON Base64",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('statementPreviewTransactions', JSON.stringify(json.transactions || []));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mimeType\": \"{{statementMimeType}}\",\n  \"base64Data\": \"{{statementBase64}}\"\n}"
            },
            "url": "{{baseUrl}}/statement-import/preview",
            "description": "Extracts income and expense rows from a statement without saving them. Put base64-only file content in statementBase64. The test script saves extracted rows into statementPreviewTransactions for the approve request."
          }
        },
        {
          "name": "Approve Previewed Statement Transactions",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = pm.collectionVariables.get('statementPreviewTransactions') || '[]';",
                  "pm.variables.set('statementPreviewTransactionsBody', rows);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const first = (json.savedTransactions || [])[0];",
                  "  if (first?.id) pm.collectionVariables.set('importedTransactionId', String(first.id));",
                  "  if (first?.id) pm.collectionVariables.set('transactionId', String(first.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactions\": {{statementPreviewTransactionsBody}}\n}"
            },
            "url": "{{baseUrl}}/statement-import/approve",
            "description": "Saves the rows from statementPreviewTransactions into the authenticated user's transaction table. Run Preview Statement JSON Base64 first, review the saved variable, then send this request."
          }
        },
        {
          "name": "Approve Statement Transactions - Manual Sample",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  const first = (json.savedTransactions || [])[0];",
                  "  if (first?.id) pm.collectionVariables.set('importedTransactionId', String(first.id));",
                  "  if (first?.id) pm.collectionVariables.set('transactionId', String(first.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactions\": [\n    {\n      \"date\": \"2026-06-01\",\n      \"description\": \"Salary credit\",\n      \"amount\": 50000,\n      \"type\": \"income\",\n      \"category\": \"Salary\",\n      \"payment_mode\": \"Bank Statement\"\n    },\n    {\n      \"date\": \"2026-06-02\",\n      \"description\": \"UPI grocery payment\",\n      \"amount\": 1250,\n      \"type\": \"expense\",\n      \"category\": \"Shopping\",\n      \"payment_mode\": \"UPI\"\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/statement-import/approve",
            "description": "Manual approve test that does not call Gemini. Useful for confirming approved statement rows are inserted into the transactions table."
          }
        },
        {
          "name": "Legacy Preview Statement JSON Base64",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('statementPreviewTransactions', JSON.stringify(json.transactions || []));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mimeType\": \"{{statementMimeType}}\",\n  \"base64Data\": \"{{statementBase64}}\"\n}"
            },
            "url": "{{baseUrl}}/ai/import-statement",
            "description": "Backward-compatible statement extraction endpoint. It now returns pendingApproval=true and does not save rows automatically."
          }
        },
        {
          "name": "Legacy Preview Statement File (PDF/Image)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('statementPreviewTransactions', JSON.stringify(json.transactions || []));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
