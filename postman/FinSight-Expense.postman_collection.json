    {
      "name": "AI - Gemini",
      "item": [
        {
          "name": "Extract Bill JSON Base64",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mimeType\": \"{{billMimeType}}\",\n  \"base64Data\": \"{{billBase64}}\"\n}"
