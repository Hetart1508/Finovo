          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/debug-otp?email={{email}}",
            "description": "Development-only helper that returns the pending registration OTP and saves it to otp."
          }
        },
        {
          "name": "Register - Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const json = pm.response.json();",
                  "  if (json.token) pm.collectionVariables.set('token', json.token);",
                  "  if (json.user && json.user.id) pm.collectionVariables.set('userId', String(json.user.id));",
                  "}"
